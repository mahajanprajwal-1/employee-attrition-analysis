table hr_dashboard_data
	lineageTag: 5d29bac3-9e3c-4cad-9e6b-9b92b6e249b0

	measure 'Total Employees' = COUNTROWS(hr_dashboard_data)
		formatString: 0
		lineageTag: 200b6ffe-7c8c-4618-8e99-67062d7349a5

	measure 'Employees Left' = SUM(hr_dashboard_data[AttritionFlag])
		formatString: 0
		lineageTag: 04f29500-ae71-4b9b-891b-fc6b844532a6

	measure 'Attrition %' = DIVIDE([Employees Left], [Total Employees])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d69c1c9a-57c3-49d0-928c-390f369bc82b

	measure 'Avg Monthly Income' = AVERAGE(hr_dashboard_data[MonthlyIncome])
		lineageTag: b8ff484d-1ae5-4ddf-b7ca-657dc761ec35

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Tenure' = AVERAGE(hr_dashboard_data[YearsAtCompany])
		lineageTag: 1505e57b-75e0-4ca9-9b1b-6362e0d6dce0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Company Avg %' = CALCULATE([Attrition %], ALL(hr_dashboard_data))
		formatString: 0.0%
		lineageTag: 5f960eec-5e93-48eb-81ae-7162653a196c

